# Copy to ~/Ariados/.env (gitignored) and fill in to enable `ariados solve`.
# Nothing is sent anywhere unless a provider is configured.

LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | ollama
LLM_API_KEY=                   # your key (not required for ollama)
# LLM_MODEL=deepseek-chat      # optional model override
# LLM_BASE_URL=                # optional endpoint override (e.g. a gateway)
