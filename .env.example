# Copy to ~/Ariados/.env (gitignored) and fill in to enable `ariados solve`.
# Nothing is sent anywhere unless a provider is configured.
# Keep comments on their own lines; put only the value after `=`.

LLM_PROVIDER=deepseek
LLM_API_KEY=

# Provider options: deepseek | openai | anthropic | ollama
# ollama needs no key (runs locally).
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/chat/completions
